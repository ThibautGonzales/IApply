# Copy to .env to override the defaults used by docker-compose.yml.
POSTGRES_USER=iapply
POSTGRES_PASSWORD=change-me
POSTGRES_DB=iapply

# Jooble job source. Get a free key at https://jooble.org/api/about
JOOBLE_API_KEY=
# If your key answers 403, try the host of the country you asked the key for (e.g. fr.jooble.org)
JOOBLE_HOST=jooble.org
# Searches are separated by ";"; each one costs at least one API call per collection
JOOBLE_KEYWORDS=développeur full stack;développeur IA;GenAI
JOOBLE_LOCATION=Clermont-Ferrand
JOOBLE_RADIUS_KM=40
