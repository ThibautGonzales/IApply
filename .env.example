# Copy to .env to override the defaults used by docker-compose.yml.
POSTGRES_USER=iapply
POSTGRES_PASSWORD=change-me
POSTGRES_DB=iapply

# Jooble job source. Get a free key from the French page: https://fr.jooble.org/api/about
JOOBLE_API_KEY=
# A key only works on the host of the country it was asked for (403 otherwise)
JOOBLE_HOST=fr.jooble.org
# Searches are separated by ";"; each one costs at least one API call per collection
JOOBLE_KEYWORDS=développeur full stack;développeur IA;GenAI
JOOBLE_LOCATION=Clermont-Ferrand
JOOBLE_RADIUS_KM=40
# Also search remote offers ("true" or "false"): each keyword is searched again
# in the remote location, which Jooble calls "Télétravail" (doubles the API calls)
JOOBLE_INCLUDE_REMOTE=true
JOOBLE_REMOTE_LOCATION=Télétravail
# Optional word added to each keyword for the remote searches
JOOBLE_REMOTE_KEYWORD=
