# Copy to .env to override the defaults used by docker-compose.yml.
POSTGRES_USER=iapply
POSTGRES_PASSWORD=change-me
POSTGRES_DB=iapply

# Jooble job source. Get a free key from the French page: https://fr.jooble.org/api/about
JOOBLE_API_KEY=
# A key only works on the host of the country it was asked for (403 otherwise)
JOOBLE_HOST=fr.jooble.org
# What to search for is worked out by the LLM from "What I am looking for" on the Profile page.
